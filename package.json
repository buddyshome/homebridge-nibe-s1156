{
  "name": "homebridge-nibe-s1156",
  "displayName": "Homebridge Nibe S1156",
  "version": "3.3.0",
  "description": "Homebridge plugin for Nibe S1156",
  "author": "Alexander Link",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buddyshome/homebridge-nibe-s1156.git"
  },
  "scripts": {
    "test": "npm run lint && npm run typecheck && node scripts/test.ts",
    "lint": "eslint src scripts",
    "lintFix": "eslint --fix src scripts",
    "typecheck": "tsc --noEmit",
    "linkHomebridge": "npm link homebridge",
    "develop": "npm run linkHomebridge && npm run build && npm link && node scripts/dev.ts",
    "clean": "node scripts/build.ts clean",
    "build": "node scripts/build.ts",
    "stop": "node scripts/stop.ts",
    "prepublishOnly": "npm run test && npm run build",
    "postpublish": "npm run clean",
    "postversion": "git push && git push --tags",
    "localinstall": "npm install --ignore-scripts"
  },
  "keywords": [
    "homebridge-plugin",
    "nibe",
    "myuplink"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  }
}
