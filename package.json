{
  "name": "homebridge-nibe-s1156",
  "displayName": "Homebridge Nibe S1156",
  "version": "3.1.0",
  "description": "Homebridge plugin for Nibe S1156",
  "author": "Alexander Link",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buddyshome/homebridge-nibe-s1156.git"
  },
  "scripts": {
    "test": "gulp test",
    "lintFix": "gulp eslintFix",
    "linkHomebridge": "npm link homebridge",
    "develop": "npm run linkHomebridge && npm run build && npm link && gulp watch",
    "clean": "gulp clean",
    "build": "npm run clean && gulp",
    "prepublishOnly": "npm run test && npm run build",
    "postpublish": "npm run clean",
    "postversion": "git push && git push --tags",
    "localinstall": "npm install --ignore-scripts"
  },
  "keywords": [
    "homebridge-plugin",
    "nibe",
    "myuplink"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "axios": "^1.7.2",
    "axios-oauth-client": "^2.2.0",
    "homebridge-ui": "^0.0.0",
    "js-yaml": "^4.1.0",
    "jsonfile": "^6.1.0",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/gulp": "^4.0.17",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonfile": "^6.1.4",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.42.1",
    "eslint": "^8.35.0",
    "eslint-config-standard": "^17.0.0",
    "gulp": "^5.0.1",
    "gulp-eslint-new": "^2.6.2",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
