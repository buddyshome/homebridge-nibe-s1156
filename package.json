{
  "name": "homebridge-nibe-s1156",
  "displayName": "Homebridge Nibe S1156",
  "version": "3.2.1",
  "description": "Homebridge plugin for Nibe S1156",
  "author": "Alexander Link",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buddyshome/homebridge-nibe-s1156.git"
  },
  "scripts": {
    "test": "npm run lint && node scripts/test.mjs",
    "lint": "eslint --ext .ts,.mjs src scripts",
    "lintFix": "eslint --fix --ext .ts,.mjs src scripts",
    "linkHomebridge": "npm link homebridge",
    "develop": "npm run linkHomebridge && npm run build && npm link && node scripts/dev.mjs",
    "clean": "node scripts/build.mjs clean",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run test && npm run build",
    "postpublish": "npm run clean",
    "postversion": "git push && git push --tags",
    "localinstall": "npm install --ignore-scripts"
  },
  "keywords": [
    "homebridge-plugin",
    "nibe",
    "myuplink"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.42.1",
    "eslint": "^8.35.0",
    "nodemon": "^3.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  }
}
