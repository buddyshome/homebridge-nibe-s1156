{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "noImplicitAny": false,
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist/",
  }
}